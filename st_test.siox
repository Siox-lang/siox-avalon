module st_test;

use std::bits::unsigned;
use avalon::st::{AvalonSt, Sink};

// Counts the beats of each packet and publishes the length at its end.
entity PacketLength { clk: Bit in, bus: AvalonSt<8> Sink,
                      length: unsigned[8] out, packets: unsigned[8] out }
impl PacketLength {
    let beats: unsigned[8] = 0;
    let last: unsigned[8] = 0;
    let count: unsigned[8] = 0;
    step: process {
        if clk.rising() {
            if bus.valid {
                if bus.endofpacket {
                    last = if bus.startofpacket { 1 } else { beats + 1 };
                    beats = 0;
                    count = count + 1;
                } else if bus.startofpacket {
                    beats = 1;
                } else {
                    beats = beats + 1;
                }
            }
        }
    }
    bus.ready = '1';
    length = last;
    packets = count;
}

#[test]
entity AvalonStTest {}
impl AvalonStTest {
    let clk: Bit = '0';
    let bus: AvalonSt<8>;
    let length: unsigned[8];
    let packets: unsigned[8];
    let dut: PacketLength = { .clk = clk, .bus = bus, .length = length, .packets = packets };

    bus.valid = '1';
    for beat in 0..2 {
        bus.data = beat;
        bus.startofpacket = Bit(beat == 0);
        bus.endofpacket = Bit(beat == 2);
        await 1ns;
        clk = '1'; await 1ns; clk = '0';
    }
    // A one-beat packet.
    bus.startofpacket = '1'; bus.endofpacket = '1';
    await 1ns;
    clk = '1'; await 1ns; clk = '0';
    bus.valid = '0';
    await 1ns;
    assert!(packets == 2 and length == 1, "two packets, the last one beat long");
    assert!(bus.ready == '1', "the sink never backpressures");
}
